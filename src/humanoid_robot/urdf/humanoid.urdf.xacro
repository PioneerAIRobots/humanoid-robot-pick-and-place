<?xml version="1.0"?>
<robot name="humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="blue"><color rgba="0.2 0.2 0.8 1"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.5"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><geometry><box size="0.3 0.2 0.5"/></geometry></collision>
    <inertial><mass value="5"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>

  <link name="head">
    <visual><geometry><sphere radius="0.12"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="0.12"/></geometry></collision>
    <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <joint name="neck_joint" type="revolute">
    <parent link="base_link"/>
    <child link="head"/>
    <origin xyz="0 0 0.31" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <xacro:macro name="arm" params="side reflect">
    <link name="${side}_upper_arm">
      <visual><origin xyz="0 0 -0.1"/><geometry><cylinder radius="0.04" length="0.2"/></geometry><material name="grey"/></visual>
      <collision><origin xyz="0 0 -0.1"/><geometry><cylinder radius="0.04" length="0.2"/></geometry></collision>
      <inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    </link>
    <joint name="${side}_shoulder_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${side}_upper_arm"/>
      <origin xyz="0 ${reflect * 0.17} 0.2" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
    </joint>

    <link name="${side}_lower_arm">
      <visual><origin xyz="0 0 -0.09"/><geometry><cylinder radius="0.035" length="0.18"/></geometry><material name="grey"/></visual>
      <collision><origin xyz="0 0 -0.09"/><geometry><cylinder radius="0.035" length="0.18"/></geometry></collision>
      <inertial><mass value="0.4"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
    </link>
    <joint name="${side}_elbow_joint" type="revolute">
      <parent link="${side}_upper_arm"/>
      <child link="${side}_lower_arm"/>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="2.5" effort="10" velocity="1"/>
    </joint>
  </xacro:macro>

  <xacro:arm side="left" reflect="1"/>
  <xacro:arm side="right" reflect="-1"/>

  <xacro:macro name="leg" params="side reflect">
    <link name="${side}_upper_leg">
      <visual><origin xyz="0 0 -0.15"/><geometry><cylinder radius="0.05" length="0.3"/></geometry><material name="dark"/></visual>
      <collision><origin xyz="0 0 -0.15"/><geometry><cylinder radius="0.05" length="0.3"/></geometry></collision>
      <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    </link>
    <joint name="${side}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${side}_upper_leg"/>
      <origin xyz="0 ${reflect * 0.08} -0.25" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.57" upper="1.57" effort="20" velocity="1"/>
    </joint>

    <link name="${side}_lower_leg">
      <visual><origin xyz="0 0 -0.15"/><geometry><cylinder radius="0.045" length="0.3"/></geometry><material name="dark"/></visual>
      <collision><origin xyz="0 0 -0.15"/><geometry><cylinder radius="0.045" length="0.3"/></geometry></collision>
      <inertial><mass value="0.8"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial>
    </link>
    <joint name="${side}_knee_joint" type="revolute">
      <parent link="${side}_upper_leg"/>
      <child link="${side}_lower_leg"/>
      <origin xyz="0 0 -0.3" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="2.3" effort="20" velocity="1"/>
    </joint>

    <link name="${side}_foot">
      <visual><origin xyz="0.05 0 -0.02"/><geometry><box size="0.18 0.08 0.04"/></geometry><material name="dark"/></visual>
      <collision><origin xyz="0.05 0 -0.02"/><geometry><box size="0.18 0.08 0.04"/></geometry></collision>
      <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
    <joint name="${side}_ankle_joint" type="fixed">
      <parent link="${side}_lower_leg"/>
      <child link="${side}_foot"/>
      <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:leg side="left" reflect="1"/>
  <xacro:leg side="right" reflect="-1"/>

</robot>
